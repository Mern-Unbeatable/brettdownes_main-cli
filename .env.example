# Leave empty in development so requests go through the Vite proxy (same-origin
# cookies). Set to the deployed API origin in production, e.g. https://api.example.com
VITE_API_URL=

# Only needed if the API runs somewhere other than http://localhost:4000 in dev
VITE_API_PROXY=http://localhost:4000

# Public site origin (no trailing slash) — used for canonical URLs, Open Graph, sitemap
VITE_SITE_URL=https://your-frontend-domain.com

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-Y9PLBJT49R
